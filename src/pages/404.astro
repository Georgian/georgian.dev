---
import PageLayout from "@/layouts/Base.astro";

const meta = {
	description: "This page doesn’t exist.",
	title: "Page not found",
};
---

<PageLayout meta={meta}>
	<main class="mx-auto w-full max-w-[688px] grow px-5 pt-16 pb-24 md:px-6 md:pt-32">
		<h1 class="reveal text-base leading-6 font-medium text-fg">Page not found</h1>
		<!-- prettier-ignore -->
		<p class="reveal mt-2" style="--stagger: 1">
			Nothing lives at this address. <a class="link" href="/">Head back home</a>.
		</p>
	</main>
</PageLayout>
