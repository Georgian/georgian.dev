---
import ArrowLink from "@/components/ArrowLink.astro";
import { HIGHLIGHTS } from "@/data/highlights";
import PageLayout from "@/layouts/Base.astro";
import { siteConfig } from "@/site-config";
import { spellOut, yearsSince } from "@/utils/yearsSince";

const meta = { title: siteConfig.title };

const ENGINEERING_SINCE = "2012-07";
const RACING_SINCE = "2016-07";
---

<PageLayout meta={meta}>
	<main class="mx-auto w-full max-w-[688px] grow px-5 pt-16 pb-24 md:px-6 md:pt-32 md:pb-32">
		<header class="reveal mb-8">
			<h1 class="text-base leading-[22px] font-medium text-fg">
				<a href="/">Georgian Grec</a>
			</h1>
		</header>

		<div class="reveal space-y-6" style="--stagger: 1">
			<p>I have a lot of hobbies. Some of them just happen to pay better.</p>
			<p>
				{spellOut(yearsSince(ENGINEERING_SINCE))} years building software.
				{spellOut(yearsSince(RACING_SINCE))} years racing bikes, the last few coaching riders too.
				Neither has become boring.
			</p>
			<p>I work best with people who question assumptions, including mine.</p>
		</div>

		<section aria-labelledby="paid" class="reveal" style="--stagger: 2">
			<h2 id="paid" class="mt-18 mb-7 text-base leading-6 font-medium text-fg">
				Paid
			</h2>
			<div class="space-y-6">
				<p>
					Backend by trade, full-stack when needed. Mostly Java and GoLang, occasionally other JVM
					languages. I've worked across finance, real estate and procurement, leading small teams
					along the way.
				</p>
				<p>I care more about the problem than the industry.</p>
			</div>
		</section>

		<div class="reveal mt-16" style="--stagger: 3">
			<div
				data-scroller
				class:list={[
					"scroll-fade -mx-5 flex snap-x snap-mandatory scroll-px-5 gap-8 overflow-x-auto px-5 md:mx-0 md:px-0",
					"[scrollbar-width:none] [&::-webkit-scrollbar]:hidden",
				]}
			>
				{HIGHLIGHTS.map((column) => (
					<section class="w-60 shrink-0 snap-start md:w-48" aria-label={column.label}>
						<h2 class="mb-3 text-sm leading-5 text-dim">{column.label}</h2>
						<ul class="flex flex-col gap-6">
							{column.entries.map((entry) => (
								<li class="min-h-19">
									{entry.url ? (
										<ArrowLink href={entry.url}>{entry.title}</ArrowLink>
									) : (
										<span class="font-medium text-fg">{entry.title}</span>
									)}
									<p class="leading-6 text-dim">{entry.description}</p>
								</li>
							))}
						</ul>
					</section>
				))}
			</div>
			<div
				data-scroll-track
				class:list={[
					"mt-4 h-0.5 rounded-full bg-line opacity-0 transition-opacity duration-300 md:hidden",
					"data-scrolling:opacity-100 data-scrolling:duration-100 motion-reduce:transition-none",
				]}
				aria-hidden="true"
			>
				<div class="h-full w-1/2 rounded-full bg-dim"></div>
			</div>
		</div>

		<section aria-labelledby="outside" class="reveal" style="--stagger: 4">
			<h2 id="outside" class="mt-14 mb-7 text-base leading-6 font-medium text-fg">
				Outside
			</h2>
			<div class="space-y-6">
				<p>
					I ride MTB, road, gravel, cyclocross. Racing when it counts. Otherwise heading for
					specialty coffee and a good pastry.
				</p>
				<p>
					Strength training year-round. Hiking, ski touring and riding motorcycles in questionable
					weather. Photography when travelling, technical books when staying put.
				</p>
				<p>One dog.</p>
			</div>
		</section>
	</main>
</PageLayout>

<script>
	const scroller = document.querySelector<HTMLElement>("[data-scroller]");
	const track = document.querySelector<HTMLElement>("[data-scroll-track]");
	const thumb = track?.firstElementChild as HTMLElement | null;

	if (scroller && track && thumb) {
		// Thumb width is the visible fraction of the strip; translating by scrollLeft / clientWidth of its own width
		// lands its right edge exactly on the track's end at maximum scroll.
		const update = () => {
			const { scrollLeft, scrollWidth, clientWidth } = scroller;
			track.hidden = scrollWidth <= clientWidth;
			thumb.style.width = `${(clientWidth / scrollWidth) * 100}%`;
			thumb.style.transform = `translateX(${(scrollLeft / clientWidth) * 100}%)`;
		};
		let idle: ReturnType<typeof setTimeout> | undefined;
		const showBar = (ms: number) => {
			track.toggleAttribute("data-scrolling", true);
			clearTimeout(idle);
			idle = setTimeout(() => track.removeAttribute("data-scrolling"), ms);
		};
		scroller.addEventListener(
			"scroll",
			() => {
				update();
				showBar(800);
			},
			{ passive: true },
		);
		new ResizeObserver(update).observe(scroller);

		// The first time the strip comes into view, nudge the columns left and back while flashing the bar, so it reads
		// as scrollable before anyone tries. A transform rather than a real scroll, which snapping would cancel out.
		// The delay lets the page's fade-in finish first when the strip is already in view on load.
		const hint = () => {
			if (scroller.scrollWidth <= scroller.clientWidth || scroller.scrollLeft > 0) return;
			showBar(1600);
			if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
			for (const column of scroller.children) {
				column.animate(
					[{ transform: "none" }, { transform: "translateX(-56px)" }, { transform: "none" }],
					{ duration: 1100, easing: "cubic-bezier(0.45, 0, 0.25, 1)" },
				);
			}
		};
		new IntersectionObserver(
			(entries, observer) => {
				if (!entries.some((entry) => entry.isIntersecting)) return;
				observer.disconnect();
				setTimeout(hint, 900);
			},
			{ threshold: 0.6 },
		).observe(scroller);
	}
</script>
