{
  "name": "georgian-grec",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "biome lint .",
    "format": "pnpm run format:code && pnpm run format:imports",
    "format:code": "biome format . --write && prettier -w \"**/*\" \"!**/*.{md,mdx}\" --ignore-unknown --cache",
    "format:imports": "biome check --formatter-enabled=false --write",
    "check": "astro check"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.6",
    "@astrojs/sitemap": "3.7.4",
    "@astrojs/vercel": "^11.0.20",
    "astro": "^7.4.7",
    "astro-expressive-code": "^0.44.3",
    "astro-icon": "^1.2.0",
    "hastscript": "^9.0.3",
    "mdast-util-directive": "^3.2.0",
    "mdast-util-to-markdown": "^2.2.2",
    "mdast-util-to-string": "^4.0.0",
    "rehype-external-links": "^3.0.0",
    "sharp": "^0.35.5",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@biomejs/biome": "^2.6.5",
    "@iconify-json/mdi": "^1.2.3",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.4",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "mdast-util-to-hast": "^13.2.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "reading-time": "^1.5.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^6.0.3"
  }
}
